APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000"]
CSRF_TRUSTED_ORIGINS=["http://localhost:3000"]
POSTGRES_DB=ahamark
POSTGRES_USER=ahamark
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://ahamark:change-me-in-production@postgres:5432/ahamark
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MINIO_ENDPOINT=minio:9000
# Optional browser-reachable host used only to sign download/preview URLs.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ahamark-local
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=ahamark-files
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=["application/pdf","image/jpeg","image/png"]
SIGNED_URL_EXPIRY_SECONDS=900
# Development-only teacher identity. Production refuses this fallback.
DEMO_ACTOR_ENABLED=true
DEMO_ACTOR_EMAIL=demo-teacher@ahamark.local
AUTH_COOKIE_NAME=ahamark_session
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
RECOGNITION_PROVIDER=unavailable
RECOGNITION_RAPIDOCR_RUNTIME_ENABLED=false
RECOGNITION_RAPIDOCR_MODEL_DOWNLOAD_ALLOWED=false
# Tesseract is the preferred open-source OCR baseline. It remains disabled until all
# absolute local paths and SHA-256 values below are supplied. It never downloads models.
RECOGNITION_TESSERACT_RUNTIME_ENABLED=false
# RECOGNITION_TESSERACT_BINARY_PATH=/opt/ahamark/tesseract/bin/tesseract
# RECOGNITION_TESSERACT_DATA_ROOT=/opt/ahamark/tesseract/tessdata
# RECOGNITION_TESSERACT_LICENSE_PATH=/opt/ahamark/tesseract/LICENSE
# RECOGNITION_TESSERACT_EXPECTED_VERSION=5.3.0
# RECOGNITION_TESSERACT_BINARY_SHA256=<64-lowercase-hex>
# RECOGNITION_TESSERACT_CHI_SIM_SHA256=<64-lowercase-hex>
# RECOGNITION_TESSERACT_ENG_SHA256=<64-lowercase-hex>
# RECOGNITION_TESSERACT_LICENSE_SHA256=<64-lowercase-hex>
RECOGNITION_TESSERACT_TIMEOUT_SECONDS=20
# Set RECOGNITION_PROVIDER=tesseract only after the explicit local files validate.
RECOGNITION_PDF_DPI=180
RECOGNITION_MAX_PDF_PAGES=100
RECOGNITION_MAX_IMAGE_PIXELS=40000000
RECOGNITION_LOW_CONFIDENCE=0.70
RECOGNITION_HIGH_CONFIDENCE=0.90
RECOGNITION_CONFIG_VERSION=2026-07-22
# Formula OCR is a separate, teacher-reviewed capability. Keep unavailable unless a
# dedicated provider is running. Development example values are intentionally omitted.
FORMULA_RECOGNITION_PROVIDER=unavailable
# FORMULA_RECOGNITION_BASE_URL=http://127.0.0.1:8765
# FORMULA_RECOGNITION_API_KEY=<inject-at-runtime-at-least-32-characters>
# FORMULA_RECOGNITION_ALLOWED_HOSTS=["127.0.0.1"]
# Formula-region detection is not connected to the product pipeline. Both switches are
# intentionally fail-closed in every environment; runtime model downloads are prohibited.
FORMULA_REGION_DETECTION_ENABLED=false
FORMULA_REGION_DETECTION_MODEL_DOWNLOAD_ALLOWED=false
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=2000
ASSIGNMENT_MAX_FILE_BYTES=26214400
ASSIGNMENT_MAX_FILES=20
SUBMISSION_MAX_FILES=100
SUBMISSION_BATCH_MAX_BYTES=262144000
SUBMISSION_MATCH_THRESHOLD=0.95
GRADING_PROVIDER=unavailable
GRADING_PROMPT_VERSION=subjective-v1
GRADING_CONFIG_VERSION=2026-07-22
GRADING_AUTO_ACCEPT_CONFIDENCE=0.95

# Assignment Generation is suggestion-only. Production secrets must be injected by the
# server environment, never supplied by clients or pasted into chat.
ASSIGNMENT_GENERATION_ENABLED=true
ASSIGNMENT_GENERATION_PROVIDER=unavailable
ASSIGNMENT_GENERATION_ALLOW_EXTERNAL_PROVIDER_REQUESTS=false
ASSIGNMENT_GENERATION_ALLOW_TEACHER_START=true
ASSIGNMENT_GENERATION_SUGGESTION_ONLY=true
ASSIGNMENT_GENERATION_REAL_PROVIDER_QUALITY_PASSED=false
# Optional real-provider settings; leave empty unless securely injected server-side.
# ASSIGNMENT_GENERATION_PROVIDER_BASE_URL=
# ASSIGNMENT_GENERATION_PROVIDER_API_KEY=
# ASSIGNMENT_GENERATION_PROVIDER_MODEL=
