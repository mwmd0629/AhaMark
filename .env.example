APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# If this changes, update the local CORS/CSRF origins below as well.
PROXY_PORT=8080
# Direct `npm run dev` uses :8000. The proxy Compose override replaces this
# with an empty build-time value so browser requests stay same-origin on :8080.
NEXT_PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080"]
CSRF_TRUSTED_ORIGINS=["http://localhost:3000","http://localhost:8080"]
TRUSTED_HOSTS=["localhost","127.0.0.1"]
POSTGRES_DB=ahamark
POSTGRES_USER=ahamark
POSTGRES_PASSWORD=change-me-in-production
DATABASE_URL=postgresql+psycopg://ahamark:change-me-in-production@postgres:5432/ahamark
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MINIO_ENDPOINT=minio:9000
# Browser-reachable same-origin proxy used only to sign download/preview URLs.
# The MinIO API and console are not published directly by Compose.
# Use localhost:9000 for direct npm-dev access. The proxy Compose override
# replaces this with the same-origin proxy host/port.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=ahamark-local
MINIO_SECRET_KEY=change-me-in-production
MINIO_BUCKET=ahamark-files
MINIO_REGION=us-east-1
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false
MAX_UPLOAD_BYTES=10485760
ALLOWED_UPLOAD_TYPES=["application/pdf","image/jpeg","image/png"]
SIGNED_URL_EXPIRY_SECONDS=900
# Development-only teacher identity. Production refuses this fallback.
DEMO_ACTOR_ENABLED=true
DEMO_ACTOR_EMAIL=demo-teacher@ahamark.local
# Development placeholder only. Production requires a dedicated random value
# of at least 32 characters, injected by the deployment secret manager.
SESSION_HMAC_SECRET=development-only-session-secret
AUTH_COOKIE_NAME=ahamark_session
AUTH_SESSION_HOURS=12
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_FAIL_CLOSED=true
RECOGNITION_PROVIDER=unavailable
# Set to rapidocr after installing `.[ocr]`; fake is development/test-only.
RECOGNITION_PDF_DPI=180
RECOGNITION_MAX_PDF_PAGES=100
RECOGNITION_MAX_IMAGE_PIXELS=40000000
RECOGNITION_LOW_CONFIDENCE=0.70
RECOGNITION_HIGH_CONFIDENCE=0.90
RECOGNITION_CONFIG_VERSION=2026-07-22
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS=2000
ASSIGNMENT_MAX_FILE_BYTES=26214400
ASSIGNMENT_MAX_FILES=20
SUBMISSION_MAX_FILES=100
SUBMISSION_BATCH_MAX_BYTES=262144000
SUBMISSION_MATCH_THRESHOLD=0.95
GRADING_PROVIDER=unavailable
GRADING_PROMPT_VERSION=subjective-v1
GRADING_CONFIG_VERSION=2026-07-22
GRADING_AUTO_ACCEPT_CONFIDENCE=0.95

# External AI calls are server-side only and disabled by default. Never prefix
# these values with NEXT_PUBLIC_ and never commit a real API key.
AI_EXTERNAL_REQUESTS_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=
# OPENAI_PROJECT=
# AI_SAFETY_HMAC_SECRET=use-a-dedicated-random-value-of-at-least-32-characters

AI_GRADING_PROVIDER=unavailable
# AI_GRADING_MODEL=
AI_GRADING_TIMEOUT_SECONDS=45
AI_GRADING_MAX_RETRIES=2
AI_GRADING_MAX_INPUT_TOKENS=16000
AI_GRADING_MAX_OUTPUT_TOKENS=4000
# Required and positive in production when AI_GRADING_PROVIDER is OpenAI.
# Maintain these values from the current provider pricing for the selected model.
AI_GRADING_INPUT_COST_PER_MILLION=0
AI_GRADING_OUTPUT_COST_PER_MILLION=0
AI_GRADING_MAX_COST_PER_QUESTION=0.25
AI_GRADING_MAX_COST_PER_BATCH=25

AI_TUTOR_PROVIDER=unavailable
# AI_TUTOR_MODEL=
AI_TUTOR_TIMEOUT_SECONDS=45
AI_TUTOR_MAX_RETRIES=2
AI_TUTOR_MAX_INPUT_TOKENS=12000
AI_TUTOR_MAX_OUTPUT_TOKENS=2000
AI_TUTOR_MAX_CONVERSATION_MESSAGES=20
AI_TUTOR_MAX_QUESTIONS_PER_HOUR=30

STUDENT_LEARNING_PROVIDER=unavailable
# STUDENT_LEARNING_MODEL=
STUDENT_LEARNING_TIMEOUT_SECONDS=60
STUDENT_LEARNING_MAX_RETRIES=2
STUDENT_LEARNING_MAX_INPUT_TOKENS=24000
STUDENT_LEARNING_MAX_OUTPUT_TOKENS=3000
STUDENT_LEARNING_MAX_GRADE_RELEASES=50
STUDENT_LEARNING_MAX_REQUESTS_PER_DAY=10
STUDENT_LEARNING_RETRY_COOLDOWN_SECONDS=300
STUDENT_UPLOAD_MAX_UNATTACHED_FILES=50
STUDENT_UPLOAD_MAX_FILES_PER_HOUR=30

# Assignment Generation is suggestion-only. Production secrets must be injected by the
# server environment, never supplied by clients or pasted into chat.
ASSIGNMENT_GENERATION_ENABLED=true
ASSIGNMENT_GENERATION_PROVIDER=unavailable
ASSIGNMENT_GENERATION_ALLOW_EXTERNAL_PROVIDER_REQUESTS=false
ASSIGNMENT_GENERATION_ALLOW_TEACHER_START=true
ASSIGNMENT_GENERATION_SUGGESTION_ONLY=true
ASSIGNMENT_GENERATION_REAL_PROVIDER_QUALITY_PASSED=false
# Optional real-provider settings; leave empty unless securely injected server-side.
# ASSIGNMENT_GENERATION_PROVIDER_BASE_URL=
# ASSIGNMENT_GENERATION_PROVIDER_API_KEY=
# ASSIGNMENT_GENERATION_PROVIDER_MODEL=
